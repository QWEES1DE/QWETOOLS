<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- nvapi64.dll — 64-битная, поэтому собираем только x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Запись в профили драйвера требует прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>QWETOOLS</AssemblyName>
    <ApplicationIcon>Assets/qwetools.ico</ApplicationIcon>
    <RootNamespace>RobRunPotato</RootNamespace>
    <Version>1.1.0</Version>

    <!-- Метаданные файла: видны в свойствах exe и снижают подозрения эвристики антивирусов -->
    <Product>QWETOOLS</Product>
    <AssemblyTitle>QWETOOLS</AssemblyTitle>
    <Company>QWETOOLS</Company>
    <Description>Настройка профилей драйвера NVIDIA для ROB RUN (LOD Bias и т.д.)</Description>
    <Copyright>© QWETOOLS. Работа программы не связана с NVIDIA.</Copyright>
    <FileVersion>1.1.0</FileVersion>
    <AssemblyVersion>1.1.0</AssemblyVersion>

    <!-- dotnet publish собирает ОДИН exe: весь .NET и ресурсы упакованы внутрь,
         файл можно переносить и раздавать без папки -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Позволяет собирать и на Linux/macOS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/avatar.jpg" LogicalName="QWETOOLS.Avatar" />
    <EmbeddedResource Include="Assets/qwetools.ico" LogicalName="QWETOOLS.Icon" />
  </ItemGroup>

</Project>
