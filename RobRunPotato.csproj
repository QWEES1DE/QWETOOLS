<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- nvapi64.dll — 64-битная, поэтому собираем только x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Запись в профили драйвера требует прав администратора -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>QWETOOLS</AssemblyName>
    <ApplicationIcon>Assets/qwetools.ico</ApplicationIcon>
    <RootNamespace>RobRunPotato</RootNamespace>
    <Version>1.0.0</Version>

    <!-- Позволяет собирать и на Linux/macOS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/avatar.jpg" LogicalName="QWETOOLS.Avatar" />
    <EmbeddedResource Include="Assets/qwetools.ico" LogicalName="QWETOOLS.Icon" />
  </ItemGroup>

</Project>
